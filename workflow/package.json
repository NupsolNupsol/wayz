{
  "name": "@wayz/workflow",
  "version": "1.0.0",
  "description": "WAYZ workflow engine — engine-agnostic state machines, validators (controllers) and operators. Pure: no database, no HTTP.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
