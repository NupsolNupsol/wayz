{
  "name": "lockerflow-agent-pos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LockerFlow Agent POS — standalone Express + MongoDB backend with a config-driven multi-engine booking workflow.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "seed": "tsx src/seed/run.ts",
    "seed:versions": "tsx src/seed/versions.run.ts",
    "test": "npm run test:roles && npm run test:rules && npm run test:notes && npm run test:shift && npm run test:lagoon && npm run test:hr",
    "test:rules": "node tests/rules.api.mjs",
    "test:notes": "node tests/clientNotes.api.mjs",
    "test:roles": "node tests/roles.api.mjs",
    "test:shift": "node tests/shift.api.mjs",
    "test:lagoon": "node tests/lagoon.api.mjs",
    "test:hr": "node tests/hr.api.mjs",
    "test:multikiosk": "node tests/multiKiosk.api.mjs",
    "test:map": "node tests/map.api.mjs"
  },
  "dependencies": {
    "@wayz/workflow": "file:../workflow",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "nanoid": "^5.0.8",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
