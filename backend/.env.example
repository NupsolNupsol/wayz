# -----------------------------------------------------------------------------
# Template only. Copy to .env and fill in real values there — .env is git-ignored,
# this file is committed, so NOTHING below may ever be a working credential.
#
#   cp .env.example .env
#
# Two execution modes read this configuration:
#
#   1. Host / non-Docker (`npm run dev`) — .env is loaded by dotenv from this directory,
#      and MONGODB_URI / REDIS_URL must point at localhost.
#   2. Docker (`docker compose up`) — docker-compose.yml supplies the container values.
#      It hardcodes the Compose service names (mongodb://mongo, redis://redis) and reads
#      only the secrets and the overridable settings below out of this same .env file.
#      dotenv does not overwrite variables that are already set, so the Compose values win
#      inside the container even though the image never receives this file.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list. The web workspace and the Expo web preview both call this API.
CORS_ORIGIN=http://localhost:5175,http://localhost:8081

# Public origin of the customer app — used to build /track/:id and /invitation/:token links.
PUBLIC_APP_URL=http://localhost:5175

# Where this API answers from as the outside world sees it. WhatsApp fetches the invoice PDF
# itself, so it must be an address Vonage can reach: in development run a tunnel
# (`cloudflared tunnel --url http://localhost:4000`) and paste the https address it prints.
# Left empty, the thank-you message still goes but without the PDF attached.
PUBLIC_API_URL=

# --- Datastores (HOST values — Docker overrides these with its service names) --
MONGODB_URI=mongodb://localhost:27017/lockerflow
REDIS_URL=redis://localhost:6379

# BullMQ reminders. false runs the sweep on an in-process timer and needs no Redis.
QUEUE_ENABLED=false

# Seed the demo tenants (WAYZ, WIQAR) on boot when the database is empty.
AUTO_SEED=true

# --- SECRET ------------------------------------------------------------------
# Required, minimum 16 characters, no default. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- What this deployment is for ---------------------------------------------
# MODE says who this server is for, which is not the same question as how it was built:
# a staging box runs a production build and is still a place a test team works.
#   live  a server customers reach. Confirmation codes are real, and only real ones work.
#   dev   a server a test team uses. STATIC_OTP below is accepted as well as the real code.
MODE=live

# A confirmation code that always works, so a scripted run can get past a code it cannot read
# on a phone. Honoured ONLY when MODE=dev, and always alongside the genuine code — the real one
# still arrives and still works, so a person at the counter is unaffected.
#
# Treat it as a secret: it is never sent to a browser and never logged. Leave it blank and
# there is no standing code at all, whatever MODE says.
#
# Keep it digits only — the code boxes are numeric — and four of them matches the codes the
# platform itself sends, which is what an agent expects to be typing. Pick your own:
#   node -e "console.log(String(Math.floor(1000 + Math.random() * 9000)))"
STATIC_OTP=

# --- Demo / test affordances -------------------------------------------------
# DEVELOPMENT AND DEMO ONLY — keep all three false anywhere real customers can reach.
#   OTP_TEST_PEEK    opens the endpoint that returns a live OTP code.
#   INVITE_TEST_PEEK returns the staff invitation link in the API response.
#   DEMO_SCANNER     returns parcel barcodes so the UI can simulate a hardware scan.
OTP_TEST_PEEK=false
INVITE_TEST_PEEK=false
DEMO_SCANNER=false

# --- Vonage: WhatsApp OTP delivery (SECRETS) ---------------------------------
# Optional. When key, secret and number are all set, OTPs are really delivered and the code
# is no longer returned to the UI; leave them blank to keep OTP in mock mode.
# For the WhatsApp sandbox, VONAGE_WHATSAPP_NUMBER is the sandbox sender number and the
# recipient phone must be whitelisted in your sandbox.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WHATSAPP_NUMBER=
# Sandbox endpoint. Production Messages API: https://api.nexmo.com/v1/messages
VONAGE_MESSAGES_URL=https://api.nexmo.com/v1/messages

# --- SMTP: email OTP channel (SECRETS) ---------------------------------------
# A send can succeed here and still never arrive: a mailbox provider will accept the message and
# then drop it if the sending domain has no SPF/DKIM/DMARC lined up. If codes are not landing,
# check the API log first — "Email sent" means the handoff worked and the problem is downstream.
# Whitespace in a password is stripped, so an app password pasted in groups of four is fine.
MAIL_HOST=mail.example.com
MAIL_DOMAIN=example.com
MAIL_PORT=465
MAIL_SECURE=true
SENDER_EMAIL=noreply@example.com
SENDER_PASSWORD=
MAIL_FROM_NAME=WAYZ

# Fallback SMTP, tried automatically when the primary host refuses or times out.
# Gmail requires an APP PASSWORD, never the account password.
MAIL_FALLBACK_HOST=smtp.gmail.com
MAIL_FALLBACK_PORT=465
MAIL_FALLBACK_SECURE=true
MAIL_FALLBACK_USER=
MAIL_FALLBACK_PASSWORD=

# --- Misc --------------------------------------------------------------------
EXPIRY_WARNING_MINUTES=15

# What an SMS appears to come from. SMS uses a sender id rather than a number, so this
# needs no provisioning — some networks reject alphanumeric senders, hence configurable.
VONAGE_SMS_FROM=WAYZ

# WhatsApp posts to the sandbox; SMS has to post to the live Messages API, because the
# sandbox carries social channels only. Two settings so both work side by side in dev.
VONAGE_WHATSAPP_URL=https://messages-sandbox.nexmo.com/v1/messages
