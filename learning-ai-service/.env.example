# -----------------------------------------------------------------------------
# Template only. Copy to .env and fill in real values there — .env is git-ignored,
# this file is committed, so NOTHING below may ever be a working credential.
#
#   cp .env.example .env
#
# Two execution modes read this configuration, exactly as backend/.env does:
#
#   1. Host / non-Docker (`uvicorn app.main:app`) — .env is loaded from this directory,
#      and QDRANT_URL / MONGODB_URI must point at localhost.
#   2. Docker (`docker compose up`) — backend/docker-compose.yml supplies the container
#      values. It hardcodes the Compose service names (http://qdrant:6333,
#      mongodb://mongo:27017) and reads only secrets and overridable settings from
#      backend/.env, which is the single .env for the whole stack.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8088

# --- Server-to-server authentication (SECRET) --------------------------------
# The LockerFlow Node API signs a 120-second token with this and this service verifies it.
# It MUST match AI_SERVICE_SECRET in backend/.env, and it must NOT be the same value as
# JWT_SECRET: a leak of one should not become a forged identity on the other.
# Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AI_SERVICE_SECRET=
AI_SERVICE_ISSUER=lockerflow-api
AI_SERVICE_AUDIENCE=lockerflow-ai

# --- OpenAI (SECRET) ---------------------------------------------------------
# Final answer generation only. Never sent to a browser, never logged, never returned in
# an error. Embeddings are local, so this is charged per question and not per document.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# "responses" is the API OpenAI currently recommends. Use "chat" for an OpenAI-compatible
# gateway that only implements chat completions.
OPENAI_API_STYLE=responses
# Point at a compatible gateway instead of api.openai.com. Leave blank for OpenAI itself.
OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TEMPERATURE=0.2

# --- Embeddings (local — no API cost) ----------------------------------------
# BAAI/bge-m3 handles Arabic well and is ~2.3 GB, downloaded once into HF_HOME and then
# cached in a Docker volume. A smaller alternative if disk or RAM is tight:
#   EMBEDDING_MODEL=intfloat/multilingual-e5-small   (~470 MB, EMBEDDING_DIM=384)
# Changing the model changes the vector width, so the Qdrant collection has to be dropped
# and every document re-indexed.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# Replaces the model with a deterministic hashing stand-in. Tests only — never in a
# deployment, where it would make retrieval lexical instead of semantic.
EMBEDDING_FAKE=false
# Load the model at startup rather than on the first question. Leave it on: BGE-M3 takes
# ~30 s to load and the alternative is that one unlucky employee waits for it.
EMBEDDING_WARMUP=true

# --- Qdrant ------------------------------------------------------------------
# Host value. Docker overrides this with the Compose service name.
QDRANT_URL=http://localhost:6333
# Leave blank for local work. Qdrant only requires a key when the server was started with
# one — see QDRANT__SERVICE__API_KEY in backend/.env.example, which must match.
QDRANT_API_KEY=
QDRANT_COLLECTION=lockerflow_knowledge

# --- Document catalogue ------------------------------------------------------
# Its own database beside the control plane and the tenants — never inside one of them.
MONGODB_URI=mongodb://localhost:27017
AI_DB_NAME=lockerflow_ai

# --- Ingestion limits --------------------------------------------------------
MAX_DOCUMENT_BYTES=2097152
ALLOWED_EXTENSIONS=.txt,.md
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_SPLIT_CHARS=1400

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
# The floor below which a nearest neighbour is not evidence. Raise it if the assistant
# starts answering from loosely related documents; lower it if it refuses too readily.
RETRIEVAL_MIN_SCORE=0.30
TENANT_SCOPE_BOOST=0.06
PAGE_MATCH_BOOST=0.05
MAX_CONTEXT_CHARS=9000

# --- Arabic text to speech (local — no API cost) -----------------------------
# piper   the ar_JO-kareem voice baked into the image at build time.
# espeak  espeak-ng, the fallback: always present, more robotic.
# none    no speech at all; the listen button reports it is not enabled.
TTS_PROVIDER=piper
PIPER_MODEL_PATH=/models/piper/ar_JO-kareem-low.onnx
TTS_MAX_CHARS=1200
TTS_CACHE_DIR=/var/cache/lockerflow-tts
