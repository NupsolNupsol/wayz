# The learning/AI service — standalone deployment.
#
# Copy to `.env` beside docker-compose.yml and fill in. Nothing here is read from LockerFlow:
# this stack starts, and stays healthy, with the LockerFlow stack stopped or absent.
#
#     cp .env.example .env
#     docker compose up -d
#
# Every variable below has a working default except AI_SERVICE_SECRET, which has none on
# purpose — see below.


# ============================================================================ REQUIRED

# The shared secret LockerFlow signs its short-lived actor tokens with.
#
# It must be *byte-identical* to AI_SERVICE_SECRET in LockerFlow's backend/.env. This is the
# only thing distinguishing LockerFlow from anybody else who can reach port 8088, so the
# service refuses to start without it rather than trusting every caller.
#
# Generate one:  openssl rand -hex 32
AI_SERVICE_SECRET=


# ============================================================================ ANSWERING

# Answer generation. Retrieval and embeddings are local and cost nothing; only the final
# wording goes to OpenAI. Leave the key empty and the service still starts, still indexes and
# still retrieves — it returns the passages it found without composing an answer from them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# `responses` for the Responses API, `chat` for Chat Completions. Match the model.
OPENAI_API_STYLE=responses


# ============================================================================ RETRIEVAL

# BGE-M3: multilingual, strong on Arabic, ~2.3 GB, downloaded on first use into the
# `ai_models` volume. Changing this changes EMBEDDING_DIM and invalidates everything already
# indexed — reindex every document afterwards.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# How close a passage must be before it is allowed to answer. Lower finds more and risks
# answering from something only loosely related; higher refuses more often and is honest
# about it.
RETRIEVAL_MIN_SCORE=0.30


# ============================================================================ SPEECH

# `piper` runs locally and costs nothing. `none` disables spoken answers entirely.
TTS_PROVIDER=piper


# ============================================================================ THE STORE

# Qdrant needs no key: it sits on this stack's internal network with no published port. To
# require one anyway, see the comment on the `qdrant` service in docker-compose.yml — it has to
# be set on both containers, and an empty value locks everything out.

# The database this service keeps its documents, embeddings and analytics in. It shares no
# collection with LockerFlow and does not need to be on the same server.
AI_DB_NAME=lockerflow_ai


# ============================================================================ THE PORT

# Where the API listens on the host.
#
# `127.0.0.1` means only this machine can reach it — correct when LockerFlow runs on the same
# host, since it talks over the `lockerflow-ai-edge` Docker network by name and does not use
# this port at all. Widen to `0.0.0.0` only behind a reverse proxy that terminates TLS.
AI_BIND=127.0.0.1
AI_PORT=8088


# ============================================================================ OPERATIONS

ENVIRONMENT=production
LOG_LEVEL=INFO
